# ── Slack ──────────────────────────────────────────────────────────────────────
# Create your app at https://api.slack.com/apps
# Required scopes: app_mentions:read, chat:write, chat:write.public, im:history, im:write
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...        # Socket Mode — from Settings > Socket Mode

# ── GitHub ─────────────────────────────────────────────────────────────────────
# Fine-grained token: Issues (Read), Pull requests (Read), Contents (Read), Metadata (Read)
GITHUB_TOKEN=ghp_...
GITHUB_ORG=your-org
GITHUB_REPO=your-repo

# ── AWS Bedrock ────────────────────────────────────────────────────────────────
# Enable Claude Sonnet 4.6 under Bedrock > Model access first
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=...

# Model ID — Claude 4.x requires the us. cross-region inference profile prefix
# Sonnet 4.6 (recommended):  us.anthropic.claude-sonnet-4-6
# Opus 4.6 (best reasoning):  us.anthropic.claude-opus-4-6-v1
# Haiku 4.5 (fastest/cheapest): us.anthropic.claude-haiku-4-5-20251001
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# ── Optional ───────────────────────────────────────────────────────────────────
# Channel to post the 9 AM morning summary (channel ID, not name)
SUMMARY_CHANNEL_ID=C...

# Additional MCP servers — add your own below
# MY_SERVICE_TOKEN=...
# MY_SERVICE_MCP_URL=https://mcp.myservice.com/mcp
